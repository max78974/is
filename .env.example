PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=data/ice-scoops.sqlite
# For one trusted reverse proxy, set to 1 in production.
TRUST_PROXY_HOPS=

# Configure for production. Generate with: node -p "require('node:crypto').randomBytes(32).toString('hex')"
ORDER_ACCESS_SECRET=

# Optional initial owner. Set both, start the app, then remove them from this file.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Leave blank to accept counter orders only. Fill all three to offer Pay Online.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
